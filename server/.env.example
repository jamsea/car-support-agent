# car-support-agent - Environment Variables
# Copy this file to .env and fill in your API keys

# Daily (Transport)
DAILY_API_KEY=
DAILY_ROOM_URL=  # Optional: leave empty to create a new room



# Deepgram (STT/TTS)
DEEPGRAM_API_KEY=
DEEPGRAM_VOICE_ID= # Optional: a Flux TTS voice. Defaults to "flux-sharon-en" (Australian).


# OpenAI (STT/LLM/TTS/Realtime)
OPENAI_API_KEY=
OPENAI_MODEL= # Optional: defaults to "gpt-4.1"

# Google Gemini (LLM)
GOOGLE_API_KEY=
GEMINI_MODEL= # Optional: defaults to "gemini-3.5-flash-lite"

# LLM
LLM_SERVICE= # Optional: "gemini" (default) or "openai". The dropdown on the web page overrides it per call.

# Store
STORE_TIMEZONE= # Optional: defaults to "Australia/Sydney"
