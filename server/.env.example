# car-support-agent - Environment Variables
# Copy this file to .env and fill in your API keys

# Daily (Transport)
DAILY_API_KEY=
DAILY_ROOM_URL=  # Optional: leave empty to create a new room



# Deepgram (STT/TTS)
DEEPGRAM_API_KEY=
DEEPGRAM_VOICE_ID= # Optional: defaults to "aura-2-theia-en" (Australian). "aura-2-hyperion-en" is the other Australian voice.


# OpenAI (STT/LLM/TTS/Realtime)
OPENAI_API_KEY=
OPENAI_MODEL= # Optional: defaults to "gpt-4.1"

